#!/usr/bin/env node
'use strict';

/**
 * agora — a chat room for agents that share this workspace.
 *
 * Deliberately dependency-free. Every broker interaction shells out to `rpk`
 * inside the Redpanda container, because rpk ships in the image and every
 * agent runtime on this machine can run a shell command. That is the whole
 * portability story: no SDK, no npm install, no per-vendor client.
 *
 * Exit codes are the API. An agent branches on these, not on stdout:
 *   0   ok / message delivered
 *   64  doorbell timed out — nothing arrived, carry on with your own work
 *   65  refused — hop cap, terminal thread, or bad input
 *   69  broker unreachable
 *   75  lease denied — someone else holds the path
 */

const { execFileSync, spawnSync } = require('child_process');
const crypto = require('crypto');
const fs = require('fs');
const path = require('path');

const CONTAINER = process.env.AGORA_CONTAINER || 'agora-redpanda';
const REPO = path.resolve(__dirname, '..');

// Topic names carry a prefix so a test run can stand up an entire parallel bus
// (`AGORA_TOPIC_PREFIX=test-a1b2.`) and drop it afterwards. Kafka cannot delete
// individual records, so the only safe way to exercise the real broker is to
// exercise a throwaway copy of it.
const PREFIX = process.env.AGORA_TOPIC_PREFIX || 'bus.';

const T = {
  threads:   PREFIX + 'threads',
  edits:     PREFIX + 'edits',
  claims:    PREFIX + 'claims',
  decisions: PREFIX + 'decisions',
  presence:  PREFIX + 'presence',
  index:     PREFIX + 'index',
  keys:      PREFIX + 'keys',
};

/**
 * How each topic is created. Partition counts and cleanup policy are protocol,
 * not deployment detail: `threads` is partitioned by thread so a conversation
 * stays ordered, and the compacted topics are state tables that happen to be
 * logs.
 */
const TOPIC_SPEC = [
  [T.threads,   ['--partitions', '6', '--config', 'retention.ms=604800000']],
  [T.edits,     ['--partitions', '1', '--config', 'retention.ms=2592000000']],
  [T.claims,    ['--partitions', '1', '--config', 'cleanup.policy=compact']],
  [T.decisions, ['--partitions', '1', '--config', 'cleanup.policy=compact']],
  [T.presence,  ['--partitions', '1', '--config', 'cleanup.policy=compact',
                 '--config', 'retention.ms=3600000']],
  [T.index,     ['--partitions', '1', '--config', 'cleanup.policy=compact']],
  [T.keys,      ['--partitions', '1', '--config', 'cleanup.policy=compact']],
];

// What a parked `wait` listens to. Presence and index are excluded on purpose,
// for the same reason: both are bookkeeping. Heartbeats would wake every agent
// constantly, and a descriptor update is a consequence of a message that has
// already rung the bell.
const WATCH = [T.threads, T.edits, T.claims, T.decisions];

const HOP_CAP = Number(process.env.AGORA_HOP_CAP) || 20;
const DEFAULT_TTL_MIN = 30;
const DEFAULT_WAIT_SEC = 900;

const THREAD_TYPES = new Set([
  'REQUEST_REVIEW', 'COMMENT', 'EVIDENCE', 'DISPUTE',
  'APPROVE', 'CONCEDE', 'INTERRUPT', 'RESOLVE', 'ESCALATE', 'DECIDE',
]);
// SUPERSEDE is terminal but deliberately absent from THREAD_TYPES: it needs a
// target to be meaningful, so it gets its own command rather than being one
// more thing you can `say` into the void.
const TERMINAL = new Set(['RESOLVE', 'ESCALATE', 'DECIDE', 'SUPERSEDE']);
const OPENERS = new Set(['REQUEST_REVIEW', 'INTERRUPT']);

const EXIT = { OK: 0, TIMEOUT: 64, REFUSED: 65, NOBROKER: 69, DENIED: 75 };

/* ── plumbing ──────────────────────────────────────────────────────── */

function rpk(args, opts = {}) {
  const res = spawnSync('docker', ['exec', CONTAINER, 'rpk', ...args], {
    encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, ...opts,
  });
  if (res.error) die(EXIT.NOBROKER, `cannot reach docker: ${res.error.message}`);
  return res;
}

function produce(topic, key, obj) {
  // Sign anything with an author whose identity is enrolled on this machine.
  // Records without a `from` (descriptors) and authors without a key (plain
  // --as, the human lane) publish unsigned — and render as such.
  if (obj.from && obj.from.agent && !obj.sig) {
    const ident = loadIdentity(obj.from.agent);
    if (ident) signEnvelope(obj, ident);
  }
  const line = JSON.stringify(obj);
  if (line.includes('\n')) die(EXIT.REFUSED, 'record contains a raw newline');
  const res = spawnSync(
    'docker',
    ['exec', '-i', CONTAINER, 'rpk', 'topic', 'produce', topic, '-k', key, '--acks', '1'],
    { input: line + '\n', encoding: 'utf8' },
  );
  if (res.status !== 0) {
    die(EXIT.NOBROKER, `produce to ${topic} failed: ${(res.stderr || '').trim()}`);
  }
  // Our own write invalidates our own view of this topic, and only this one —
  // producing to one topic cannot change another.
  _readCache.delete(topic);
  _boundsCache.delete(topic);
  _topicSet = null;
  if (topic === T.keys) _keysMemo = null;
  return obj;
}

const _readCache = new Map();
const _boundsCache = new Map();
let _topicSet = null;

function topicExists(t) {
  if (!_topicSet) _topicSet = existingTopics();
  return _topicSet.has(t);
}

/**
 * Per-partition log bounds, so a read can prove it saw everything.
 *
 * The record at `end - 1` is the newest in its partition, so nothing supersedes
 * it and compaction keeps it. That makes "did I see offset end-1 in every
 * non-empty partition" a completeness check that is valid for the compacted
 * topics as well as the retained ones.
 */
function partitionBounds(topic) {
  if (_boundsCache.has(topic)) return _boundsCache.get(topic);
  const res = rpk(['topic', 'describe', topic, '-p']);
  if (res.status !== 0) {
    die(EXIT.NOBROKER, `cannot read partition bounds for ${topic}: ${(res.stderr || '').trim()}`);
  }
  const lines = (res.stdout || '').split('\n').filter((l) => l.trim());
  const head = (lines.shift() || '').trim().split(/\s+/);
  const iP = head.indexOf('PARTITION');
  const iS = head.indexOf('LOG-START-OFFSET');
  const iE = head.indexOf('HIGH-WATERMARK');
  const out = new Map();
  if (iP < 0 || iS < 0 || iE < 0) return out;      // unfamiliar rpk output — skip the check
  for (const l of lines) {
    const c = l.trim().split(/\s+/);
    const p = Number(c[iP]); const st = Number(c[iS]); const en = Number(c[iE]);
    if (Number.isFinite(p) && Number.isFinite(st) && Number.isFinite(en)) out.set(p, { start: st, end: en });
  }
  _boundsCache.set(topic, out);
  return out;
}

/**
 * Bounded read: everything currently in the topic, then exit. Never blocks.
 *
 * `rpk topic consume -o :end` sometimes returns early **and exits 0**. Observed
 * on this bus: a topic holding 191 records returned 142 on one call and 191 on
 * the next, with no error on either. The old implementation returned whatever
 * arrived, so a short read became a confident wrong answer — a thread that
 * exists looks absent, `list` under-reports, and an agent opens the duplicate
 * this tool exists to prevent.
 *
 * So a read now has to prove it is complete before anything is allowed to
 * believe it: every non-empty partition must yield its head offset, or the read
 * is retried, and a read that stays short is fatal rather than partial.
 */
function readAll(topic) {
  if (_readCache.has(topic)) return _readCache.get(topic);
  // A topic that does not exist yet is empty, not broken — `doctor` on a fresh
  // install has to be able to say so rather than dying on the way to saying it.
  if (!topicExists(topic)) return [];

  const want = new Map();
  for (const [p, b] of partitionBounds(topic)) if (b.end > b.start) want.set(p, b.end - 1);

  let short = '';
  for (let attempt = 1; attempt <= 3; attempt++) {
    const res = rpk(['topic', 'consume', topic, '-o', ':end', '-f', 'json', '--pretty-print=false']);
    if (res.status !== 0) {
      die(EXIT.NOBROKER,
        `read of ${topic} failed: ${(res.stderr || `rpk exited ${res.status}`).trim()}`);
    }
    const out = [];
    let undecodable = 0;
    for (const l of (res.stdout || '').split('\n')) {
      if (!l) continue;
      try {
        const rec = JSON.parse(l);
        const env = JSON.parse(rec.value);
        env._offset = rec.offset;
        env._partition = rec.partition;
        out.push(env);
      } catch { undecodable++; }
    }
    // Skipped rather than fatal, deliberately: Kafka cannot delete a record, so
    // one malformed message would otherwise brick every command on this topic
    // permanently. Loud, and survivable.
    if (undecodable) {
      process.stderr.write(`agora: warning — skipped ${undecodable} undecodable record(s) in ${topic}\n`);
    }

    const seen = new Map();
    for (const e of out) {
      const p = e._partition;
      if (!seen.has(p) || seen.get(p) < e._offset) seen.set(p, e._offset);
    }
    const missing = [...want].filter(([p, head]) => !(seen.get(p) >= head));
    if (!missing.length) {
      _readCache.set(topic, out);
      return out;
    }
    short = missing
      .map(([p, head]) => `p${p} stopped at ${seen.has(p) ? seen.get(p) : 'nothing'} of ${head}`)
      .join(', ');
    process.stderr.write(`agora: warning — short read of ${topic} (${short}), retrying ${attempt}/3\n`);
  }
  die(EXIT.NOBROKER,
    `${topic} kept returning a short read (${short}) — refusing to answer from partial history`);
}

function die(code, msg) {
  process.stderr.write(`agora: ${msg}\n`);
  process.exit(code);
}

function now() { return new Date().toISOString(); }

function mkid() {
  return Date.now().toString(36) + '-' + crypto.randomBytes(4).toString('hex');
}

function agentName(flags) {
  const a = flags.as || process.env.AGORA_AGENT;
  if (!a) die(EXIT.REFUSED, 'who are you? pass --as <agent> or set AGORA_AGENT');
  return a;
}

function groupFor(agent) { return `agora.${agent}`; }

function parseTtl(s) {
  if (!s) return DEFAULT_TTL_MIN;
  const m = /^(\d+)\s*(m|min|h)?$/.exec(String(s).trim());
  if (!m) die(EXIT.REFUSED, `bad --ttl "${s}" (try 30m or 2h)`);
  return m[2] === 'h' ? Number(m[1]) * 60 : Number(m[1]);
}

/**
 * Resolve a cited path. Relative paths are anchored to this repo, not to the
 * caller's cwd — participants run from whichever repo they happen to be in, and
 * a citation has to mean the same file to everyone reading it. An absolute path
 * is honoured as-is so a session working elsewhere can still cite its own files.
 */
function resolveRef(p) {
  return path.isAbsolute(p) ? p : path.resolve(REPO, p);
}

function shaOf(rel) {
  const abs = resolveRef(rel);
  if (!fs.existsSync(abs)) return null;
  return crypto.createHash('sha256').update(fs.readFileSync(abs)).digest('hex').slice(0, 16);
}

/**
 * A citation is `path#L10-20`. We pin the file's hash at write time so a reply
 * that arrives after the file moved can be flagged rather than silently argued
 * about. This is the difference between citing a file and citing a version.
 */
function parseRef(spec) {
  const [p, lines] = String(spec).split('#');
  const sha = shaOf(p);
  if (sha === null) die(EXIT.REFUSED, `--ref points at a missing file: ${p}`);
  return { path: p, lines: lines || null, sha256: sha };
}

function markStale(env) {
  for (const r of env.refs || []) {
    const cur = shaOf(r.path);
    r.stale = cur === null ? 'deleted' : (cur !== r.sha256);
  }
  return env;
}

/* ── identity and signing ──────────────────────────────────────────── */

/**
 * The registrar, single-host edition. There is no service to call: identity
 * lives in a keypair on disk, the public half is published to the compacted
 * `bus.keys` topic, and every reader verifies for itself. Same instinct as the
 * index — keep the broker dumb and the clients able to answer without a
 * control plane in the path.
 *
 * What signing buys here is attribution, not access. Anything on the port can
 * still write; what it can no longer do is write *as someone else* without the
 * forgery being visible to every reader. Access control is the hosted mode's
 * problem (SASL/ACL); attribution is this one's.
 */

function identityDir() {
  return process.env.AGORA_IDENTITY_DIR || path.join(REPO, '.agora', 'identity');
}

function identityFile(agent) { return path.join(identityDir(), `${agent}.json`); }

function loadIdentity(agent) {
  try {
    const d = JSON.parse(fs.readFileSync(identityFile(agent), 'utf8'));
    return d && d.principal && d.private_pem ? d : null;
  } catch { return null; }
}

let _keysMemo = null;
/** principal → key record, and handle → key record. Last write per key wins,
 *  which is also how revocation would work: publish a superseding record. */
function keysTable() {
  if (_keysMemo) return _keysMemo;
  const byPrincipal = new Map(); const byAgent = new Map();
  for (const e of readAll(T.keys)) {
    if (e.type !== 'KEY' || !e.principal) continue;
    byPrincipal.set(e.principal, e);
    if (e.agent) byAgent.set(e.agent, e);
  }
  return (_keysMemo = { byPrincipal, byAgent });
}

/**
 * The canonical form: the signed fields, serialized in one fixed order, with
 * absent fields pinned to null so that "field missing" and "field null" cannot
 * be two different byte strings that verify differently. Refs are reduced to
 * the three fields that carry meaning; `_offset`-style reader annotations and
 * the signature itself are never part of what is signed.
 */
function canonicalForm(env) {
  const refs = (env.refs || []).map((r) => ({
    path: r.path || null, lines: r.lines || null, sha256: r.sha256 || null,
  }));
  return JSON.stringify({
    v: 1,
    id: env.id || null,
    ts: env.ts || null,
    type: env.type || null,
    thread: env.thread || null,
    subject: env.subject || null,
    into: env.into || null,
    agent: (env.from && env.from.agent) || null,
    via: (env.from && env.from.via) || null,
    hop: env.hop == null ? null : env.hop,
    reply_to: env.reply_to || null,
    body: env.body || null,
    digest: env.digest || null,
    ask_human: env.ask_human || null,
    refs,
  });
}

function signEnvelope(env, ident) {
  const sig = crypto.sign(null, Buffer.from(canonicalForm(env)), ident.private_pem);
  env.from.principal = ident.principal;
  env.sig = { alg: 'ed25519', principal: ident.principal, signature: sig.toString('base64') };
  return env;
}

/**
 * Verify one envelope against the published keys.
 *
 * Returns: 'ok' · 'unsigned' · 'unknown-key' · 'bad-sig' · 'wrong-agent'.
 * Nothing is ever dropped for failing — an unverifiable message renders as
 * untrusted and stays in the conversation, because silently losing a peer's
 * message is worse than reading one you distrust. 'wrong-agent' is the case
 * signing exists for: a valid signature from a key that was enrolled to a
 * different handle than the message claims to be from.
 */
function verifyEnvelope(env) {
  if (!env.sig || !env.sig.signature) return 'unsigned';
  const rec = keysTable().byPrincipal.get(env.sig.principal);
  if (!rec || !rec.public_pem) return 'unknown-key';
  let good = false;
  try {
    good = crypto.verify(null, Buffer.from(canonicalForm(env)),
      rec.public_pem, Buffer.from(env.sig.signature, 'base64'));
  } catch { good = false; }
  if (!good) return 'bad-sig';
  if (env.from && env.from.agent !== rec.agent) return 'wrong-agent';
  return 'ok';
}

/** Reader-side annotation, alongside markStale: stamp the verification verdict
 *  so JSON consumers get it without re-deriving the canonical form. */
function markVerified(env) {
  env._sig = verifyEnvelope(env);
  return env;
}

/* ── lease table (compacted topic → last write per path wins) ──────── */

function leases() {
  const table = new Map();
  for (const e of readAll(T.claims)) {
    if (e.type === 'RELEASE') table.delete(e.subject);
    else table.set(e.subject, e);
  }
  const live = new Map();
  for (const [p, e] of table) {
    if (new Date(e.expires_at).getTime() > Date.now()) live.set(p, e);
  }
  return live;
}

/* ── the index (compacted topic → one descriptor per thread) ───────── */

/**
 * Discovery has to keep working when nothing else does. An agent most needs to
 * know what else is in flight precisely when the control plane is unwell, so
 * the index is a compacted topic every client can read for itself rather than
 * an endpoint on a service that can be down. Descriptors are keyed by thread,
 * so compaction leaves exactly one per conversation and the whole index is
 * cheap to pull and filter locally.
 *
 * DIVERGE records share the topic under their own key namespace — one record
 * per (new thread, declined candidate) pair, which is also exactly the dedup
 * you want if the same call gets made twice.
 */
function indexRead() {
  const desc = new Map();
  const diverges = [];
  for (const e of readAll(T.index)) {
    if (e.type === 'DIVERGE') diverges.push(e);
    else if (e.thread) desc.set(e.thread, e);
  }
  return { desc, diverges };
}

/** Tokens used for weak title/tag matching. Short words carry no signal. */
function tokens(s) {
  return new Set(String(s || '').toLowerCase().split(/[^a-z0-9]+/).filter((w) => w.length > 2));
}

/**
 * Rebuild a thread's descriptor from the log and publish it.
 *
 * The publishing client owns this, not the operator — that is what keeps
 * discovery working with no operator running at all. Everything here is derived
 * from messages that are already on the bus, except the fields a human or agent
 * supplied at open time (title, work item, tags), which are carried forward
 * from the previous descriptor.
 */
function refreshDescriptor(thread, extra = {}) {
  const d = computeDescriptor(thread, extra);
  produce(T.index, thread, d);
  return d;
}

/** The descriptor a thread's log implies, without publishing it. The operator
 *  diffs this against what is stored and writes only on drift — a compacted
 *  topic churned with identical records every sweep is self-inflicted noise. */
function computeDescriptor(thread, extra = {}) {
  const prev = indexRead().desc.get(thread) || {};
  const msgs = readAll(T.threads).filter((e) => e.thread === thread)
    .sort((a, b) => (a.ts < b.ts ? -1 : 1));
  const edits = readAll(T.edits).filter((e) => e.thread === thread);

  const participants = [];
  for (const m of msgs) {
    const a = m.from && m.from.agent;
    if (a && a !== 'agora' && !participants.includes(a)) participants.push(a);
  }

  const paths = new Set(prev.paths || []);
  for (const m of msgs) for (const r of m.refs || []) if (r.path) paths.add(r.path);
  for (const e of edits) if (e.subject) paths.add(e.subject);
  for (const p of extra.paths || []) paths.add(p);

  const decided = msgs.find((m) => m.type === 'DECIDE');
  const term = decided || msgs.find((m) => TERMINAL.has(m.type));
  const status = extra.status
    || (term ? (term.type === 'DECIDE' ? 'decided'
      : term.type === 'ESCALATE' ? 'escalated'
        : term.type === 'SUPERSEDE' ? 'superseded' : 'resolved')
      : 'open');

  const opener = msgs[0];
  const d = {
    id: mkid(), ts: now(), type: 'DESCRIPTOR', thread,
    title: extra.title || prev.title
      || (opener && opener.body ? opener.body.slice(0, 120) : null),
    work_item: extra.work_item || prev.work_item || null,
    status,
    hop: msgs.reduce((m, e) => Math.max(m, e.hop || 0), 0),
    participants,
    paths: [...paths],
    tags: extra.tags || prev.tags || [],
    superseded_by: extra.superseded_by || prev.superseded_by || null,
    absorbed: extra.absorbed || prev.absorbed || [],
    opened_at: prev.opened_at || (opener ? opener.ts : now()),
    last_at: msgs.length ? msgs[msgs.length - 1].ts : now(),
  };
  return d;
}

/** The fields that make two descriptors materially different. id/ts churn on
 *  every write and opened_at is sticky, so none of them count as drift. */
function descriptorMaterial(d) {
  return JSON.stringify({
    title: d.title || null, work_item: d.work_item || null, status: d.status,
    hop: d.hop, participants: d.participants || [],
    paths: [...(d.paths || [])].sort(), tags: d.tags || [],
    superseded_by: d.superseded_by || null, absorbed: d.absorbed || [],
    last_at: d.last_at || null,
  });
}

/**
 * Open threads that already cite a path.
 *
 * This is the collision the lease model misses: two agents can each edit a file
 * nobody has claimed while a live conversation is deciding what that file
 * should say. A lease answers "may I write"; this answers "is anyone already
 * arguing about it", which is the more useful question and the one that was
 * unanswerable before the index existed.
 */
function threadsTouching(p) {
  const { desc } = indexRead();
  return [...desc.values()].filter(
    (d) => d.status === 'open' && (d.paths || []).includes(p),
  );
}

/** Descriptor refresh must never be able to fail a message that was delivered.
 *  The message is the truth; the descriptor is a convenience over it, and a
 *  wrong descriptor costs a missed convergence, never corruption. */
function refreshQuietly(thread, extra) {
  try { return refreshDescriptor(thread, extra); }
  catch (err) {
    process.stderr.write(`agora: warning — index not updated for ${thread}: ${err.message}\n`);
    return null;
  }
}

/* ── presence ──────────────────────────────────────────────────────── */

const PRESENCE_STALE_MIN = 20;

/** Last known state per agent. An agent is "live" if it has published presence
 *  recently — `wait` heartbeats on every park, so a session that is listening
 *  keeps itself fresh without any extra work. */
function presenceTable() {
  const seen = new Map();
  for (const e of readAll(T.presence)) seen.set(e.from.agent, e);
  const out = new Map();
  for (const [a, e] of seen) {
    out.set(a, { ...e, live: (Date.now() - new Date(e.ts)) < PRESENCE_STALE_MIN * 60000 });
  }
  return out;
}

function heartbeat(agent, state) {
  produce(T.presence, agent, {
    id: mkid(), ts: now(), type: 'PRESENCE', from: { agent }, state,
  });
}

/* ── thread state ──────────────────────────────────────────────────── */

function threadState(id) {
  const msgs = readAll(T.threads).filter((e) => e.thread === id);
  msgs.sort((a, b) => (a.ts < b.ts ? -1 : 1));
  const hop = msgs.reduce((m, e) => Math.max(m, e.hop || 0), 0);
  const terminal = msgs.find((e) => TERMINAL.has(e.type)) || null;
  return { msgs, hop, terminal, exists: msgs.length > 0 };
}

/**
 * Who is responsible for putting this question in front of a human.
 *
 * An escalation that nobody owns is just a log line, and an escalation that
 * everybody owns gets the user asked N times. So exactly one agent is named,
 * and the rule is deterministic enough that every participant computes the
 * same answer from the same log: the agent that opened the thread, unless its
 * session has gone quiet, in which case the earliest other live participant
 * inherits it. Nobody live means nobody is named — the escalation waits on the
 * dashboard until someone joins.
 */
function escalationOwner(msgs) {
  const live = presenceTable();
  const order = [];
  for (const m of msgs) {
    const a = m.from && m.from.agent;
    if (a && a !== 'agora' && a !== 'human' && !order.includes(a)) order.push(a);
  }
  for (const a of order) if (live.get(a) && live.get(a).live) return a;
  return null;
}

/* ── rendering ─────────────────────────────────────────────────────── */

function render(e, me) {
  const who = e.from ? e.from.agent : 'agora';
  const head = [`[${e.type}]`, `${who}`];
  // Attribution verdict, computed at read time. Quiet when good; loud when the
  // signature claims a handle the key was never enrolled to.
  const v = e._sig !== undefined ? e._sig : verifyEnvelope(e);
  if (v === 'wrong-agent') head.push('⚠ SIGNED BY A KEY ENROLLED TO A DIFFERENT AGENT');
  else if (v === 'bad-sig') head.push('⚠ SIGNATURE INVALID');
  else if (v === 'unknown-key') head.push('[key not on the bus]');
  else if (v === 'unsigned') head.push('[unsigned]');
  if (e.thread) head.push(`thread=${e.thread}`);
  if (e.hop) head.push(`hop=${e.hop}/${HOP_CAP}`);
  if (e.subject) head.push(`path=${e.subject}`);
  const out = [head.join('  ')];
  if (e.reply_to) out.push(`  reply-to: ${e.reply_to}`);
  if (e.type === 'SUPERSEDE' && e.into) out.push(`  superseded-by: ${e.into}  (read it — this thread's evidence travels with it)`);
  if (e.type === 'RELATED' && e.into) out.push(`  related: ${e.into}  (a suggestion, not a merge — merging is your judgement)`);
  if (e.body) out.push(`  ${e.body}`);
  for (const r of e.refs || []) {
    const tag = r.stale === 'deleted' ? '  [REF DELETED SINCE]'
      : r.stale ? '  [REF STALE — file changed since this was written]' : '';
    out.push(`  ref: ${r.path}${r.lines ? '#' + r.lines : ''} @${r.sha256}${tag}`);
  }
  if (e.digest) out.push(`  positions: ${e.digest}`);
  if (e.ask_human) {
    out.push(e.ask_human === me
      ? [
        '',
        '  ┌─────────────────────────────────────────────────────────────┐',
        '  │  YOU OWN THIS ESCALATION — STOP AND ASK YOUR USER           │',
        '  └─────────────────────────────────────────────────────────────┘',
        '  Put the question to the human in your own session. Summarise both',
        '  positions and what you need decided. Do not answer it yourself, and',
        '  do not reopen the thread. When they answer, relay it verbatim:',
        '',
        `    agora decide --thread ${e.thread} --via ${me} -m "<their answer>"`,
      ].join('\n')
      : `  ask-human: ${e.ask_human} is asking their user — do not also ask yours`);
  } else if (e.type === 'ESCALATE') {
    out.push('  ask-human: nobody live to ask — waiting on the dashboard');
  }
  out.push(`  id=${e.id} ts=${e.ts}`);
  return out.join('\n');
}

/* ── commands ──────────────────────────────────────────────────────── */

const cmds = {};

/** Topic names that actually exist. Parsed rather than substring-matched, so a
 *  prefixed test bus cannot be mistaken for the real one. */
function existingTopics() {
  const res = rpk(['topic', 'list']);
  // "I could not ask" and "there are none" are different answers, and conflating
  // them is how an unreachable broker came to report an empty bus instead of an
  // error — the same silent-degradation bug as a short read, one level down.
  if (res.status !== 0) {
    die(EXIT.NOBROKER,
      `cannot list topics: ${(res.stderr || `rpk exited ${res.status}`).trim()}`);
  }
  return new Set(
    (res.stdout || '').split('\n').slice(1).map((l) => l.trim().split(/\s+/)[0]).filter(Boolean),
  );
}

/**
 * Topic creation used to live only in the getting-started doc, which means the
 * first thing a new install could get wrong was the one thing the protocol
 * depends on — partition counts and compaction policy. It belongs in the tool.
 */
cmds.topics = (flags) => {
  const have = existingTopics();
  const missing = TOPIC_SPEC.filter(([n]) => !have.has(n));
  if (!flags.ensure) {
    for (const [n, spec] of TOPIC_SPEC) {
      console.log(`${have.has(n) ? 'ok      ' : 'MISSING '}${n.padEnd(20)} ${spec.join(' ')}`);
    }
    if (missing.length) console.log(`\n${missing.length} missing — create with: agora topics --ensure`);
    return;
  }
  if (!missing.length) return console.log(`all ${TOPIC_SPEC.length} topics present — nothing to do`);
  for (const [n, spec] of missing) {
    const res = rpk(['topic', 'create', n, ...spec]);
    if (res.status !== 0) die(EXIT.NOBROKER, `create ${n} failed: ${(res.stderr || res.stdout || '').trim()}`);
    console.log(`created ${n}  ${spec.join(' ')}`);
  }
};

cmds.doctor = () => {
  const health = rpk(['cluster', 'health']);
  if (health.status !== 0) die(EXIT.NOBROKER, 'broker not reachable — try: docker compose up -d');
  const healthy = /Healthy:\s+true/.test(health.stdout);
  const missing = TOPIC_SPEC.map(([n]) => n).filter((t) => !existingTopics().has(t));
  console.log(`broker    ${healthy ? 'healthy' : 'UNHEALTHY'}  (${CONTAINER})`);
  console.log(`topics    ${missing.length
    ? `MISSING: ${missing.join(', ')}  → agora topics --ensure`
    : `all ${TOPIC_SPEC.length} present`}`);
  console.log(`repo      ${REPO}`);
  console.log(`agent     ${process.env.AGORA_AGENT || '(unset — pass --as)'}`);
  const l = leases();
  console.log(`leases    ${l.size ? [...l.keys()].join(', ') : 'none held'}`);
  const opPid = (() => {
    try {
      const pid = Number(fs.readFileSync(path.join(tmpDir(), 'agora-operator.pid'), 'utf8').trim());
      process.kill(pid, 0); return pid;
    } catch { return null; }
  })();
  console.log(`operator  ${opPid ? `running (pid ${opPid})` : 'not running (optional — TTLs and read-side recompute cover the gaps)'}`);
  if (!healthy || missing.length) process.exit(EXIT.NOBROKER);
};

/** Seed the group at the live end so a first `wait` doesn't replay history. */
cmds.join = (flags) => {
  const agent = agentName(flags);
  const g = groupFor(agent);
  // --allow-new-topics matters: without it, seeking a group that has never
  // committed an offset fails — and it fails on exit code alone, so for the
  // entire life of the prototype a brand-new agent's join silently did not
  // seek, and its first wait replayed all of history. Check the status.
  const sought = rpk(['group', 'seek', g, '--to', 'end', '--allow-new-topics',
    '--topics', WATCH.join(',')]);
  if (sought.status !== 0) {
    die(EXIT.NOBROKER, `could not seek ${g} to the live end: ${(sought.stderr || sought.stdout || '').trim()}`);
  }
  produce(T.presence, agent, {
    id: mkid(), ts: now(), type: 'PRESENCE', from: { agent }, state: 'listening',
  });
  console.log(`joined as ${agent} (group ${g}, seeked to end of ${WATCH.length} topics)`);
};

cmds.claim = (flags, args) => {
  const agent = agentName(flags);
  const target = args[0];
  if (!target) die(EXIT.REFUSED, 'usage: agora claim <path> [--ttl 30m] [--thread T]');
  const held = leases().get(target);
  if (held && held.from.agent !== agent) {
    const left = Math.round((new Date(held.expires_at) - Date.now()) / 60000);
    process.stderr.write(
      `agora: DENIED — ${target} held by ${held.from.agent}, ~${left}m remaining\n`,
    );
    // A refusal that only refuses makes the agent guess. One that names the
    // conversation turns the refusal into a routing instruction.
    for (const d of threadsTouching(target)) {
      process.stderr.write(
        `agora:   discussing in ${d.thread} (hop ${d.hop}/${HOP_CAP}, ${(d.participants || []).join(', ')})`
        + ` — agora read ${d.thread}\n`,
      );
    }
    process.exit(EXIT.DENIED);
  }
  const mins = parseTtl(flags.ttl);
  const e = produce(T.claims, target, {
    id: mkid(), ts: now(), type: 'CLAIM', from: { agent },
    subject: target,
    expires_at: new Date(Date.now() + mins * 60000).toISOString(),
    sha256_at_claim: shaOf(target),
    thread: flags.thread || null,
  });
  if (flags.thread) refreshQuietly(flags.thread, { paths: [target] });
  console.log(`GRANTED  ${target}  → ${agent}  (ttl ${mins}m, expires ${e.expires_at})`);
};

cmds.release = (flags, args) => {
  const agent = agentName(flags);
  const target = args[0];
  if (!target) die(EXIT.REFUSED, 'usage: agora release <path>');
  const held = leases().get(target);
  if (held && held.from.agent !== agent) {
    die(EXIT.DENIED, `${target} is held by ${held.from.agent}, not you`);
  }
  produce(T.claims, target, {
    id: mkid(), ts: now(), type: 'RELEASE', from: { agent }, subject: target,
  });
  console.log(`released ${target}`);
};

cmds.edit = (flags, args) => {
  const agent = agentName(flags);
  const target = args[0];
  if (!target) die(EXIT.REFUSED, 'usage: agora edit <path> [--thread T] [-m "what changed"]');
  const held = leases().get(target);
  if (held && held.from.agent !== agent) {
    die(EXIT.DENIED, `refusing to log an edit to ${target} — held by ${held.from.agent}`);
  }
  if (!held) {
    process.stderr.write(`agora: warning — no lease held on ${target}\n`);
  }
  for (const d of threadsTouching(target)) {
    if (d.thread === flags.thread) continue;               // you are in that thread already
    process.stderr.write(
      `agora: warning — ${d.thread} is open and cites ${target} — agora read ${d.thread}\n`,
    );
  }
  const sha = shaOf(target);
  if (sha === null) die(EXIT.REFUSED, `no such file: ${target}`);
  produce(T.edits, target, {
    id: mkid(), ts: now(), type: 'EDIT', from: { agent },
    subject: target, thread: flags.thread || null,
    body: flags.m || flags.message || null,
    refs: [{ path: target, lines: null, sha256: sha }],
  });
  if (flags.thread) refreshQuietly(flags.thread, { paths: [target] });
  console.log(`logged EDIT  ${target}  @${sha}`);
};

cmds.say = (flags, args) => {
  const agent = agentName(flags);
  const type = String(args[0] || '').toUpperCase();
  if (type === 'SUPERSEDE') {
    die(EXIT.REFUSED, 'SUPERSEDE needs a target: agora supersede --thread <source> --into <target>');
  }
  if (!THREAD_TYPES.has(type)) {
    die(EXIT.REFUSED, `unknown type "${args[0]}" — one of: ${[...THREAD_TYPES].join(', ')}`);
  }
  if (type === 'DECIDE' && agent !== 'human' && !process.env.AGORA_HUMAN) {
    die(EXIT.REFUSED, 'DECIDE is reserved for the human lane');
  }
  const thread = flags.thread;
  if (!thread) die(EXIT.REFUSED, 'every message needs --thread <id>');
  const body = flags.m || flags.message;
  if (!body) die(EXIT.REFUSED, 'say something: -m "..."');

  const st = threadState(thread);
  if (!st.exists && !OPENERS.has(type)) {
    die(EXIT.REFUSED, `thread ${thread} does not exist — open it with REQUEST_REVIEW`);
  }
  if (st.terminal && type !== 'DECIDE') {
    die(EXIT.REFUSED,
      `thread ${thread} is closed (${st.terminal.type} at ${st.terminal.ts}) — open a new one`);
  }

  // Terminal messages close a thread rather than continuing it, so they do not
  // consume a hop — otherwise a DECIDE that ends a capped thread renders as
  // the nonsense "hop 10/8".
  const hop = TERMINAL.has(type) ? st.hop : st.hop + 1;
  // The guard rail. Two models with a channel and no terminal condition will
  // agree with each other for as long as you fund it.
  if (hop > HOP_CAP && !TERMINAL.has(type)) {
    const positions = st.msgs.slice(-4).map((m) => `${m.from.agent}: ${m.body}`).join(' | ');
    const owner = escalationOwner(st.msgs);
    produce(T.threads, thread, {
      id: mkid(), ts: now(), type: 'ESCALATE', from: { agent: 'agora' },
      thread, hop: st.hop, body:
        `Hop cap reached (${HOP_CAP}). Refused: ${agent} → ${type}. Handing to @human.`,
      digest: positions,
      ask_human: owner,
    });
    refreshQuietly(thread, { status: 'escalated' });
    process.stderr.write(
      `agora: REFUSED — hop ${hop} exceeds cap ${HOP_CAP}. ESCALATE posted; drop the thread.\n`,
    );
    process.stderr.write(owner === agent
      ? `agora: YOU own this escalation — ask your user, then: `
        + `agora decide --thread ${thread} --via ${agent} -m "<their answer>"\n`
      : `agora: ${owner || 'nobody live'} owns asking the human. Do not ask yours.\n`);
    process.exit(EXIT.REFUSED);
  }

  const refs = [];
  for (const r of [].concat(flags.ref || [])) refs.push(parseRef(r));

  // A hand-written ESCALATE names an owner too, on the same rule as the
  // automatic one — otherwise "ask the human" is nobody's job.
  const ask = type === 'ESCALATE' ? escalationOwner(st.msgs.concat([{ from: { agent } }])) : null;

  produce(T.threads, thread, {
    id: mkid(), ts: now(), type, from: { agent },
    thread, hop, reply_to: flags['reply-to'] || null,
    body, refs, ask_human: ask,
  });
  refreshQuietly(thread);
  console.log(`sent ${type} on ${thread} (hop ${hop}/${HOP_CAP})`);
  if (type === 'ESCALATE') {
    console.log(ask === agent
      ? `  YOU own this escalation — ask your user, then:\n`
        + `    agora decide --thread ${thread} --via ${agent} -m "<their answer>"`
      : `  ask-human: ${ask || 'nobody live'}`);
  }
};

/**
 * Ratify. `--via <agent>` records that a human answered through an agent's
 * session rather than typing it themselves — the ruling is still the human's,
 * but the audit trail shows how it arrived.
 */
cmds.decide = (flags, args) => {
  const via = flags.via || null;
  const body = flags.m || flags.message;
  if (!flags.thread) die(EXIT.REFUSED, 'usage: agora decide --thread <id> [--via <agent>] -m "..."');
  if (!body) die(EXIT.REFUSED, 'a ruling needs words: -m "..."');

  const st = threadState(flags.thread);
  if (!st.exists) die(EXIT.REFUSED, `thread ${flags.thread} does not exist`);
  const prior = st.msgs.find((m) => m.type === 'DECIDE');
  if (prior) die(EXIT.REFUSED, `${flags.thread} was already decided at ${prior.ts}`);

  const from = via ? { agent: 'human', via } : { agent: 'human' };
  produce(T.threads, flags.thread, {
    id: mkid(), ts: now(), type: 'DECIDE', from,
    thread: flags.thread, hop: st.hop, body, refs: [],
  });
  produce(T.decisions, flags.thread, {
    id: mkid(), ts: now(), type: 'DECISION', from,
    thread: flags.thread, body,
  });
  refreshQuietly(flags.thread, { status: 'decided' });
  console.log(`DECIDE recorded on ${flags.thread}${via ? ` (relayed via ${via})` : ''}`);
  console.log(`ratified on ${T.decisions} (key=${flags.thread})`);
};

/** Open escalations and who owes the human a question. */
cmds.escalations = (flags) => {
  const byThread = new Map();
  for (const e of readAll(T.threads)) {
    if (!e.thread) continue;
    if (!byThread.has(e.thread)) byThread.set(e.thread, []);
    byThread.get(e.thread).push(e);
  }
  const rows = [];
  for (const [id, msgs] of byThread) {
    msgs.sort((a, b) => (a.ts < b.ts ? -1 : 1));
    const esc = msgs.find((m) => m.type === 'ESCALATE');
    if (!esc) continue;
    if (msgs.some((m) => m.type === 'DECIDE')) continue;      // already answered
    rows.push({ id, esc, msgs });
  }
  if (!rows.length) return console.log('(no escalations waiting on a human)');
  const me = flags.as || process.env.AGORA_AGENT;
  for (const r of rows) {
    // Recompute rather than trusting the stamp — the named owner may have gone
    // away since, and somebody live should pick it up.
    const current = escalationOwner(r.msgs);
    const mine = current === me ? '  ← YOURS' : '';
    console.log(`${r.id.padEnd(24)} waiting ${Math.round((Date.now() - new Date(r.esc.ts)) / 60000)}m  `
      + `ask-human: ${current || 'nobody live'}${mine}`);
    if (r.esc.digest) console.log(`  ${r.esc.digest.slice(0, 160)}`);
  }
};

/** The doorbell. Blocks until something lands or the timeout expires. */
cmds.wait = (flags) => {
  const agent = agentName(flags);
  const secs = Number(flags.timeout || DEFAULT_WAIT_SEC);
  // Parking a doorbell is proof of life, so it doubles as the heartbeat that
  // keeps this agent eligible to own an escalation.
  if (!flags._resumed) heartbeat(agent, 'waiting');
  const res = spawnSync('docker', [
    'exec', CONTAINER, 'timeout', String(secs),
    'rpk', 'topic', 'consume', ...WATCH,
    '-g', groupFor(agent), '-n', '1', '-f', 'json', '--pretty-print=false',
  ], { encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });

  if (res.status === 124) process.exit(EXIT.TIMEOUT);          // GNU timeout
  if (res.status !== 0) die(EXIT.NOBROKER, (res.stderr || 'consume failed').trim());

  const line = (res.stdout || '').split('\n').filter(Boolean)[0];
  if (!line) process.exit(EXIT.TIMEOUT);

  let env;
  try { env = markVerified(markStale(JSON.parse(JSON.parse(line).value))); }
  catch { die(EXIT.REFUSED, 'undecodable record on the bus'); }

  // Your own messages come back to you; skip them rather than waking on an echo.
  if (env.from && env.from.agent === agent) return cmds.wait({ ...flags, _resumed: true });

  console.log(flags.json ? JSON.stringify(env) : render(env, agent));
};

cmds.catchup = (flags) => {
  const all = [...readAll(T.threads), ...readAll(T.edits), ...readAll(T.claims)]
    .filter((e) => (flags.thread ? e.thread === flags.thread : true))
    .sort((a, b) => (a.ts < b.ts ? -1 : 1))
    .map(markStale);
  if (!all.length) return console.log('(nothing on the bus yet)');
  const me = flags.as || process.env.AGORA_AGENT;
  console.log(all.map((e) => (flags.json ? JSON.stringify(markVerified(e)) : render(e, me))).join('\n\n'));
};

cmds.threads = () => {
  const byThread = new Map();
  for (const e of readAll(T.threads)) {
    if (!e.thread) continue;
    if (!byThread.has(e.thread)) byThread.set(e.thread, []);
    byThread.get(e.thread).push(e);
  }
  if (!byThread.size) return console.log('(no threads)');
  for (const [id, msgs] of byThread) {
    msgs.sort((a, b) => (a.ts < b.ts ? -1 : 1));
    // A human ruling supersedes whatever closed the thread first — an escalated
    // thread that has since been decided is decided, not still escalated.
    const decided = msgs.find((m) => m.type === 'DECIDE');
    const term = decided || msgs.find((m) => TERMINAL.has(m.type));
    const esc = msgs.find((m) => m.type === 'ESCALATE');
    const pending = esc && !decided ? `  ASK:${escalationOwner(msgs) || 'unclaimed'}` : '';
    const hop = msgs.reduce((m, e) => Math.max(m, e.hop || 0), 0);
    const who = [...new Set(msgs.map((m) => m.from.agent))].join(', ');
    console.log(
      `${term ? term.type.padEnd(8) : 'OPEN'.padEnd(8)} ${id.padEnd(22)} ` +
      `hop ${hop}/${HOP_CAP}  ${msgs.length} msgs  [${who}]${pending}`,
    );
    console.log(`         ${msgs[msgs.length - 1].body || ''}`.slice(0, 110));
  }
};

cmds.presence = () => {
  const seen = new Map();
  for (const e of readAll(T.presence)) seen.set(e.from.agent, e);
  if (!seen.size) return console.log('(nobody has joined)');
  for (const [a, e] of seen) {
    const age = Math.round((Date.now() - new Date(e.ts)) / 1000);
    console.log(`${a.padEnd(14)} ${e.state.padEnd(10)} last seen ${age}s ago`);
  }
};

cmds.leases = () => {
  const l = leases();
  if (!l.size) return console.log('(no leases held)');
  for (const [p, e] of l) {
    const left = Math.round((new Date(e.expires_at) - Date.now()) / 60000);
    console.log(`${e.from.agent.padEnd(14)} ${p.padEnd(44)} ${left}m left`);
  }
};

/** Whole-bus snapshot as one JSON document. The dashboard reads this rather
 *  than re-implementing record parsing, so there is one place that knows the
 *  envelope shape. */
cmds.dump = () => {
  const out = {
    at: now(),
    threads: readAll(T.threads).map(markStale),
    edits: readAll(T.edits).map(markStale),
    claims: readAll(T.claims),
    decisions: readAll(T.decisions),
    presence: readAll(T.presence),
    index: [...indexRead().desc.values()],
    leases: [...leases().values()],
    hop_cap: HOP_CAP,
  };
  process.stdout.write(JSON.stringify(out));
};

/**
 * Dashboard lifecycle.
 *
 * The web server used to be started as a background job of whichever agent
 * session happened to be running, which meant it died whenever that session's
 * background tasks were reaped. A monitoring service with a shorter life than
 * the thing it monitors is not much use, so it now detaches from its parent and
 * is tracked by pidfile — same lifecycle as the broker, independent of any
 * session.
 */
cmds.web = (flags, args) => {
  const dir = path.join(REPO, '.agora', 'tmp');
  const PID = path.join(dir, 'agora-web.pid');
  const LOG = path.join(dir, 'agora-web.log');
  const port = process.env.AGORA_WEB_PORT || 7788;
  fs.mkdirSync(dir, { recursive: true });

  const running = () => {
    if (!fs.existsSync(PID)) return null;
    const pid = Number(fs.readFileSync(PID, 'utf8').trim());
    try { process.kill(pid, 0); return pid; } catch { fs.unlinkSync(PID); return null; }
  };

  const sub = args[0] || 'status';

  if (sub === 'status') {
    const pid = running();
    console.log(pid ? `running  pid ${pid}  →  http://localhost:${port}` : 'stopped');
    return process.exit(pid ? EXIT.OK : EXIT.REFUSED);
  }

  // The dashboard's tail runs inside the container via `docker exec`, and
  // Docker does not kill it when the client dies. The server reaps on SIGTERM,
  // but a SIGKILLed or crashed server cannot — so sweep here too. Orphaned
  // tails spin against deleted topics and are expensive: three once held ~155%
  // CPU while the broker itself idled at 0.4%.
  const reapTails = () => {
    const sh = 'for p in /proc/[0-9]*; do'
      + ' c=$(tr "\\0" " " < "$p/cmdline" 2>/dev/null);'
      + ' case "$c" in */rpk\\ topic\\ consume*) kill -9 "${p#/proc/}" 2>/dev/null ;; esac;'
      + ' done';
    spawnSync('docker', ['exec', CONTAINER, 'sh', '-c', sh], { encoding: 'utf8', timeout: 10000 });
  };

  // Killing a process and immediately rebinding its port loses the race: the
  // new server dies on EADDRINUSE and the pidfile then points at a corpse.
  // Wait for it to actually go, and escalate if it will not.
  const sleepSync = (ms) => { Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms); };
  const stopPid = (pid) => {
    try { process.kill(pid, 'SIGTERM'); } catch { return; }
    for (let i = 0; i < 50; i++) {                 // up to 5s
      sleepSync(100);
      try { process.kill(pid, 0); } catch { return; }
    }
    try { process.kill(pid, 'SIGKILL'); sleepSync(200); } catch { /* already gone */ }
  };

  if (sub === 'stop') {
    const pid = running();
    if (pid) { stopPid(pid); try { fs.unlinkSync(PID); } catch {} }
    reapTails();
    return console.log(pid ? `stopped pid ${pid}, tails reaped` : 'not running; tails reaped');
  }

  if (sub === 'start' || sub === 'restart') {
    const pid = running();
    if (pid && sub === 'start') {
      return console.log(`already running  pid ${pid}  →  http://localhost:${port}`);
    }
    if (pid) { stopPid(pid); try { fs.unlinkSync(PID); } catch {} }
    const out = fs.openSync(LOG, 'a');
    const child = require('child_process').spawn(
      process.execPath, [path.join(REPO, 'bin', 'agora-web')],
      { detached: true, stdio: ['ignore', out, out] },
    );
    child.unref();
    fs.writeFileSync(PID, String(child.pid));
    console.log(`started pid ${child.pid}  →  http://localhost:${port}`);
    console.log(`log     ${LOG}`);
    return;
  }

  die(EXIT.REFUSED, 'usage: agora web start|stop|restart|status');
};

/* ── the operator ──────────────────────────────────────────────────── */

/**
 * A reconcile loop, not a gatekeeper. Nobody calls the operator and nothing
 * waits on it: every write it makes is one a client could have made, so a dead
 * operator degrades the bus to exactly what it was before the operator
 * existed — leases wait out their TTL instead of being reaped, escalation
 * ownership goes stale until someone runs `escalations`, descriptors drift
 * until someone runs `reindex`, and related threads go unnoticed. Nothing
 * blocks. That degradation story is the Q4 answer, and it is tested, because
 * an untested fallback is how the first dashboard died with a background task.
 *
 * The sweep is deliberately a one-shot command. The daemon is nothing but
 * `sweep` on an interval — which means the whole reconcile behavior can be
 * tested synchronously, and a human can run one sweep by hand and read what
 * it did.
 */

function tmpDir() {
  return process.env.AGORA_TMP_DIR || path.join(REPO, '.agora', 'tmp');
}

const REAP_MIN = Number(process.env.AGORA_REAP_MIN) || 45;

/** The system identity. Hop-cap escalations and operator repairs publish as
 *  "agora"; give that handle a key so system messages verify like anyone
 *  else's. Idempotent, and self-heals a key that never reached the bus. */
function ensureSystemIdentity() {
  const have = loadIdentity('agora');
  const pub = keysTable().byAgent.get('agora');
  if (have && pub && pub.public_pem === have.public_pem) return false;
  let ident = have;
  if (!ident) {
    const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519');
    ident = {
      agent: 'agora', base: 'agora',
      principal: `agent://agora-operator/${path.basename(REPO)}/${crypto.randomBytes(4).toString('hex')}`,
      runtime: 'agora-operator',
      public_pem: publicKey.export({ type: 'spki', format: 'pem' }),
      private_pem: privateKey.export({ type: 'pkcs8', format: 'pem' }),
      enrolled_at: now(),
    };
    fs.mkdirSync(identityDir(), { recursive: true, mode: 0o700 });
    fs.writeFileSync(identityFile('agora'), JSON.stringify(ident, null, 2), { mode: 0o600 });
  }
  produce(T.keys, 'agora', {
    id: mkid(), ts: now(), type: 'KEY',
    agent: 'agora', principal: ident.principal, public_pem: ident.public_pem,
    runtime: 'agora-operator', workspace: path.basename(REPO),
  });
  return true;
}

/**
 * One reconcile pass. Reads the whole bus once, compares reality to intent,
 * and returns the list of repairs — which `--dry-run` prints without making.
 * Every action is idempotent: a second sweep over a repaired bus is a no-op,
 * and the tests hold the operator to that, because a reconciler that churns
 * is a reconciler you eventually turn off.
 */
function operatorSweep(dry) {
  const actions = [];
  const act = (kind, detail, fn) => {
    actions.push({ kind, detail });
    if (!dry) fn();
  };

  if (dry) {
    const have = loadIdentity('agora');
    const pub = keysTable().byAgent.get('agora');
    if (!have || !pub || pub.public_pem !== have.public_pem) {
      actions.push({ kind: 'identity', detail: 'system key for "agora" needs publishing' });
    }
  } else if (ensureSystemIdentity()) {
    actions.push({ kind: 'identity', detail: 'published the system key for "agora"' });
  }

  const live = presenceTable();
  const silentMin = (a) => {
    const p = live.get(a);
    return p ? Math.round((Date.now() - new Date(p.ts)) / 60000) : Infinity;
  };

  // 1. Leases held by the silent. TTL already bounds every lease; this only
  // matters for long grants whose holder stopped heartbeating. The threshold
  // is deliberately far past presence-staleness: an agent deep in a long work
  // stint between doorbells looks quiet, and reaping a live worker's lease is
  // the exact clobbering leases exist to prevent.
  for (const [p, lease] of leases()) {
    const holder = lease.from.agent;
    const quiet = silentMin(holder);
    const leftMin = Math.round((new Date(lease.expires_at) - Date.now()) / 60000);
    if (quiet >= REAP_MIN && leftMin > 5) {
      act('reap-lease', `${p} (held by ${holder}, silent ${quiet === Infinity ? 'forever' : quiet + 'm'}, ${leftMin}m left)`,
        () => produce(T.claims, p, {
          id: mkid(), ts: now(), type: 'RELEASE', from: { agent: 'agora' },
          subject: p, on_behalf_of: holder,
          body: `lease reaped: ${holder} silent ${quiet === Infinity ? 'with no presence record' : quiet + 'm'} (threshold ${REAP_MIN}m)`,
        }));
    }
  }

  // 2. Escalations owned by the dead. The stamped owner may have gone away;
  // the reader-side recompute already handles display, but only a message on
  // the bus *wakes* the inheritor's parked doorbell.
  const byThread = new Map();
  for (const e of readAll(T.threads)) {
    if (!e.thread) continue;
    if (!byThread.has(e.thread)) byThread.set(e.thread, []);
    byThread.get(e.thread).push(e);
  }
  for (const [id, msgs] of byThread) {
    msgs.sort((a, b) => (a.ts < b.ts ? -1 : 1));
    const escs = msgs.filter((m) => m.type === 'ESCALATE');
    if (!escs.length || msgs.some((m) => m.type === 'DECIDE')) continue;
    const stamped = escs[escs.length - 1].ask_human || null;
    const current = escalationOwner(msgs);
    if (current && current !== stamped) {
      act('escalation-owner', `${id}: ${stamped || 'nobody'} → ${current}`,
        () => {
          produce(T.threads, id, {
            id: mkid(), ts: now(), type: 'ESCALATE', from: { agent: 'agora' },
            thread: id, hop: msgs.reduce((m, e) => Math.max(m, e.hop || 0), 0),
            body: `Escalation ownership passed to ${current} — ${stamped || 'the prior owner'} has gone quiet. Ask your user and DECIDE.`,
            digest: escs[0].digest || null,
            ask_human: current,
          });
          refreshQuietly(id);        // the post moved last_at; keep the sweep idempotent
        });
    }
  }

  // 3. Descriptor drift. Clients write the index on every publish; this
  // catches what a crashed client missed and threads that predate the index.
  const knownDesc = indexRead().desc;
  for (const id of byThread.keys()) {
    const fresh = computeDescriptor(id);
    const stored = knownDesc.get(id);
    if (!stored || descriptorMaterial(stored) !== descriptorMaterial(fresh)) {
      act('index-repair', `${id} ${stored ? 'drifted' : 'missing'} → ${fresh.status}, hop ${fresh.hop}`,
        () => produce(T.index, id, fresh));
    }
  }

  // 4. Open threads sharing a path get a RELATED pointer in each direction —
  // once. It suggests; it never merges. Merging is a judgement about subject
  // matter, and the operator has no view of subject matter, only of paths.
  const open = [...knownDesc.values()].filter((d) => d.status === 'open');
  for (let i = 0; i < open.length; i++) {
    for (let j = i + 1; j < open.length; j++) {
      const a = open[i]; const b = open[j];
      const shared = (a.paths || []).filter((x) => (b.paths || []).includes(x));
      if (!shared.length) continue;
      for (const [from, to] of [[a, b], [b, a]]) {
        const already = (byThread.get(from.thread) || []).some(
          (m) => m.type === 'RELATED' && m.into === to.thread);
        if (already) continue;
        act('related', `${from.thread} ⇄ ${to.thread} (share ${shared.join(', ')})`,
          () => {
            produce(T.threads, from.thread, {
              id: mkid(), ts: now(), type: 'RELATED', from: { agent: 'agora' },
              thread: from.thread, into: to.thread, hop: null,
              body: `${to.thread} is also discussing ${shared.join(', ')} — agora read ${to.thread}. `
                + 'Related, not merged: if they are one subject, supersede; if not, carry on.',
              refs: [],
            });
            refreshQuietly(from.thread);   // the post moved last_at; keep the sweep idempotent
          });
      }
    }
  }

  return actions;
}

cmds.operator = (flags, args) => {
  const sub = args[0] || 'status';
  const dir = tmpDir();
  const PID = path.join(dir, 'agora-operator.pid');
  const LOG = path.join(dir, 'agora-operator.log');
  fs.mkdirSync(dir, { recursive: true });

  if (sub === 'sweep') {
    const dry = !!flags['dry-run'];
    const actions = operatorSweep(dry);
    if (flags.json) return console.log(JSON.stringify({ at: now(), dry, actions }));
    if (!actions.length) return console.log(`sweep: nothing to repair${dry ? ' (dry run)' : ''}`);
    for (const a of actions) console.log(`${dry ? 'would ' : ''}${a.kind.padEnd(17)} ${a.detail}`);
    console.log(`${actions.length} repair${actions.length > 1 ? 's' : ''}${dry ? ' pending (dry run — nothing written)' : ''}`);
    return;
  }

  const running = () => {
    if (!fs.existsSync(PID)) return null;
    const pid = Number(fs.readFileSync(PID, 'utf8').trim());
    try { process.kill(pid, 0); return pid; } catch { fs.unlinkSync(PID); return null; }
  };
  const sleepSync = (ms) => { Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms); };
  const stopPid = (pid) => {
    try { process.kill(pid, 'SIGTERM'); } catch { return; }
    for (let i = 0; i < 50; i++) { sleepSync(100); try { process.kill(pid, 0); } catch { return; } }
    try { process.kill(pid, 'SIGKILL'); sleepSync(200); } catch { /* gone */ }
  };

  if (sub === 'status') {
    const pid = running();
    console.log(pid
      ? `running  pid ${pid}  (sweep every ${Number(process.env.AGORA_SWEEP_SEC) || 30}s, log ${LOG})`
      : 'stopped  — degraded, not broken: TTLs, read-side recompute and reindex still cover everything');
    return process.exit(pid ? EXIT.OK : EXIT.REFUSED);
  }

  if (sub === 'stop') {
    const pid = running();
    if (pid) { stopPid(pid); try { fs.unlinkSync(PID); } catch {} }
    return console.log(pid ? `stopped pid ${pid}` : 'not running');
  }

  if (sub === 'start' || sub === 'restart') {
    const pid = running();
    if (pid && sub === 'start') return console.log(`already running  pid ${pid}`);
    if (pid) { stopPid(pid); try { fs.unlinkSync(PID); } catch {} }
    const out = fs.openSync(LOG, 'a');
    const child = require('child_process').spawn(
      process.execPath, [path.join(REPO, 'bin', 'agora-operator')],
      { detached: true, stdio: ['ignore', out, out] },
    );
    child.unref();
    fs.writeFileSync(PID, String(child.pid));
    console.log(`started pid ${child.pid}  (sweep every ${Number(process.env.AGORA_SWEEP_SEC) || 30}s)`);
    console.log(`log     ${LOG}`);
    return;
  }

  die(EXIT.REFUSED, 'usage: agora operator sweep [--dry-run] [--json] | start | stop | restart | status');
};

/* ── enrollment ────────────────────────────────────────────────────── */

/**
 * One call to be oriented. Enroll replaces the join/list/escalations dance:
 * it assigns an identity, publishes the public key, seeks the doorbell to the
 * live end, and returns everything the agent needs to start working.
 *
 * The handle is assigned, not chosen. `--name claude` is a request for a base;
 * what comes back is `claude-a` (or -b, -c…), allocated against the published
 * key table, because the handle is what everything else attributes to and two
 * sessions must not be able to pick the same one. Re-enrolling from the same
 * machine reclaims the same handle by proving it still holds the private key.
 *
 * The context deliberately returns descriptors and pointers, not full thread
 * histories. The spec's first draft said "with full history"; the Q9
 * measurement then found bare history replay is the one unbounded cost on the
 * bus (~145k tokens and growing, against ~64 for descriptors). Orientation
 * hands you the map; `agora read <thread>` is one command away for the
 * conversations that turn out to matter.
 */
cmds.enroll = (flags) => {
  const base = slug(flags.name || process.env.AGORA_RUNTIME || 'agent');
  if (!base) die(EXIT.REFUSED, 'usage: agora enroll --name <base> [--runtime R] [--json]');
  const runtime = String(flags.runtime || flags.name || base);
  const keys = keysTable();

  // Reclaim: a local key file whose public half matches the published record
  // is the same session lineage, whatever "session" the runtime thinks it is.
  let handle = null; let ident = null;
  try {
    for (const f of fs.readdirSync(identityDir())) {
      if (!f.endsWith('.json')) continue;
      const cand = JSON.parse(fs.readFileSync(path.join(identityDir(), f), 'utf8'));
      const pub = keys.byAgent.get(cand.agent);
      if (cand.base === base && pub && pub.public_pem === cand.public_pem) {
        handle = cand.agent; ident = cand; break;
      }
    }
  } catch { /* no identity dir yet — fresh machine */ }

  if (!handle) {
    // Allocate the next free suffix, then prove we won it: publish, re-read,
    // and if the record that survived is not our key, someone else claimed the
    // handle in the same window — take the next one.
    const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519');
    const pubPem = publicKey.export({ type: 'spki', format: 'pem' });
    const privPem = privateKey.export({ type: 'pkcs8', format: 'pem' });
    const suffixes = 'abcdefghijklmnopqrstuvwxyz';
    for (let i = 0; i < suffixes.length && !handle; i++) {
      const cand = `${base}-${suffixes[i]}`;
      if (keys.byAgent.has(cand)) continue;
      const principal = `agent://${runtime}/${path.basename(REPO)}/${crypto.randomBytes(4).toString('hex')}`;
      produce(T.keys, cand, {
        id: mkid(), ts: now(), type: 'KEY',
        agent: cand, principal, public_pem: pubPem,
        runtime, workspace: path.basename(REPO),
      });
      const won = keysTable().byAgent.get(cand);
      if (won && won.public_pem === pubPem) {
        handle = cand;
        ident = { agent: cand, base, principal, runtime,
          public_pem: pubPem, private_pem: privPem, enrolled_at: now() };
        fs.mkdirSync(identityDir(), { recursive: true, mode: 0o700 });
        fs.writeFileSync(identityFile(cand), JSON.stringify(ident, null, 2), { mode: 0o600 });
      }
    }
    if (!handle) die(EXIT.REFUSED, `could not allocate a handle for base "${base}" — 26 taken?`);
  }

  // Line up: doorbell to the live end, presence announced. Same effect as
  // `join`, folded in so enroll is genuinely one call.
  const sought = rpk(['group', 'seek', groupFor(handle), '--to', 'end',
    '--allow-new-topics', '--topics', WATCH.join(',')]);
  if (sought.status !== 0) {
    die(EXIT.NOBROKER, `enrolled, but could not seek ${groupFor(handle)} to the live end: `
      + `${(sought.stderr || sought.stdout || '').trim()}`);
  }
  heartbeat(handle, 'listening');

  // Context: the map, not the territory.
  const { desc } = indexRead();
  const open = [...desc.values()].filter((d) => d.status === 'open');
  const mine = open.filter((d) => (d.participants || []).includes(handle));
  const escalations = [];
  for (const e of readAll(T.threads)) {
    if (e.type !== 'ESCALATE' || !e.thread) continue;
    const st = threadState(e.thread);
    if (st.msgs.some((m) => m.type === 'DECIDE')) continue;
    if (escalationOwner(st.msgs) === handle) escalations.push(e.thread);
  }
  const live = [...presenceTable().entries()]
    .filter(([a, p]) => p.live && a !== handle).map(([a]) => a);
  const heldLeases = [...leases().values()]
    .map((l) => ({ path: l.subject, holder: l.from.agent, expires_at: l.expires_at }));

  const doc = {
    protocol: 'agora/1',
    identity: { agent: handle, principal: ident.principal, key_file: identityFile(handle) },
    context: {
      threads_open: open.map((d) => ({
        thread: d.thread, title: d.title, hop: d.hop,
        participants: d.participants, paths: d.paths, yours: mine.includes(d),
      })),
      escalations_owned: [...new Set(escalations)],
      leases: heldLeases,
      peers_live: live,
    },
  };
  if (flags.json) return console.log(JSON.stringify(doc, null, 2));

  console.log(`enrolled as ${handle}   (${ident.principal})`);
  console.log(`  key      ${identityFile(handle)} — messages you send are now signed`);
  console.log(`  doorbell seeked to live end; presence announced`);
  console.log('');
  if (doc.context.escalations_owned.length) {
    console.log(`  YOU OWE A HUMAN AN ANSWER on: ${doc.context.escalations_owned.join(', ')}`);
  }
  console.log(open.length
    ? `  open threads (${open.length}):`
    : '  no open threads.');
  for (const t of doc.context.threads_open) {
    console.log(`    ${t.thread.padEnd(34)} hop ${t.hop}/${HOP_CAP}  [${(t.participants || []).join(', ')}]${t.yours ? '  ← yours' : ''}`);
  }
  if (live.length) console.log(`  live peers: ${live.join(', ')}`);
  console.log('');
  console.log(`  next: agora read <thread> for anything above that concerns you,`);
  console.log(`        agora wait --as ${handle} to park the doorbell.`);
};

cmds.whoami = (flags) => {
  const agent = agentName(flags);
  const ident = loadIdentity(agent);
  const pub = keysTable().byAgent.get(agent);
  if (!ident) {
    console.log(`${agent} — no enrolled identity on this machine (messages publish unsigned)`);
    if (pub) console.log(`  NOTE: "${agent}" is enrolled on the bus by someone else (${pub.principal})`);
    return;
  }
  const match = pub && pub.public_pem === ident.public_pem;
  console.log(`${agent}   (${ident.principal})`);
  console.log(`  key       ${identityFile(agent)}`);
  console.log(`  published ${match ? 'yes — signatures verify' : pub ? 'CONFLICT — bus holds a different key for this handle' : 'NO — key not on the bus; re-enroll'}`);
};

/* ── convergence ───────────────────────────────────────────────────── */

function slug(str) {
  return String(str || '').toLowerCase()
    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
    .split('-').filter(Boolean).slice(0, 5).join('-');
}

/**
 * A thread id is derived, never invented, whenever there is anything to derive
 * it from. Two agents working the same item compute the same id independently
 * and land in the same conversation without coordinating — convergence as
 * arithmetic rather than as lookup. Only when there is no work item does the
 * title get slugified, and that is the case where matching has to do the work.
 */
function deriveThreadId(title, workItem) {
  if (workItem) {
    const w = String(workItem);
    if (/^[a-z][a-z0-9+.-]*:\/\//.test(w)) return w;      // already an address
    return `thread://${process.env.AGORA_TRACKER || 'work'}/${w}`;
  }
  const sl = slug(title);
  if (!sl) die(EXIT.REFUSED, '--title needs some words in it');
  return `th-${sl}`;
}

function csv(v) {
  if (v === undefined || v === true) return [];
  return String(v).split(',').map((x) => x.trim()).filter(Boolean);
}

/**
 * Rank existing threads against an intent, deterministic tiers first.
 *
 * Each candidate carries why it matched. A bare similarity score is
 * unadjudicable — the agent is being asked to make a judgement, so it needs the
 * grounds, not a number.
 */
function rankCandidates(intent) {
  const { desc } = indexRead();
  const out = [];
  const wantTokens = tokens(`${intent.title} ${intent.tags.join(' ')}`);

  for (const d of desc.values()) {
    if (d.status !== 'open') continue;
    if (d.thread === intent.thread) {
      out.push({ d, tier: 'exact', why: ['the derived thread id is this thread'] });
      continue;
    }
    if (intent.work_item && d.work_item && d.work_item === intent.work_item) {
      out.push({ d, tier: 'exact', why: [`same work item ${intent.work_item}`] });
      continue;
    }
    const overlap = (d.paths || []).filter((x) => intent.paths.includes(x));
    if (overlap.length) {
      out.push({
        d,
        tier: 'strong',
        why: [`${overlap.length} of ${intent.paths.length} paths overlap: ${overlap.join(', ')}`],
      });
      continue;
    }
    const shared = [...wantTokens].filter((w) => tokens(`${d.title} ${(d.tags || []).join(' ')}`).has(w));
    if (shared.length >= 2) {
      out.push({ d, tier: 'weak', why: [`title/tag overlap: ${shared.slice(0, 5).join(', ')}`] });
    }
  }
  const rank = { exact: 0, strong: 1, weak: 2 };
  out.sort((a, b) => rank[a.tier] - rank[b.tier]
    || String(b.d.last_at || '').localeCompare(String(a.d.last_at || '')));
  return out;
}

function printCandidates(cands) {
  console.log(`CANDIDATES (${cands.length})`);
  for (const c of cands) {
    const d = c.d;
    console.log(`  ${d.thread.padEnd(34)}${c.tier.padEnd(8)}${d.status} · hop ${d.hop}/${HOP_CAP}`
      + ` · ${(d.participants || []).join(', ') || 'nobody yet'}`);
    if (d.title) console.log(`    title:   ${d.title.slice(0, 96)}`);
    for (const w of c.why) console.log(`    matched: ${w}`);
  }
}

/**
 * Which tier is allowed to block a new thread.
 *
 * This is a dial with a bad failure at each end, and the ends are not
 * symmetric: fragmentation is recoverable — that is what SUPERSEDE is for —
 * and a thread carrying two tangled arguments is not. So the default is the
 * loose end. Tighten it on evidence: a low DIVERGE rate against a given tier
 * means the matcher could be trusted with more.
 */
const BLOCK_TIER = process.env.AGORA_MATCH_BLOCK || 'exact';
const BLOCKS = { none: [], exact: ['exact'], strong: ['exact', 'strong'] }[BLOCK_TIER]
  || ['exact'];

cmds.open = (flags, args) => {
  const agent = agentName(flags);

  // Reading a thread is not joining it. `--join` prints the history and stops;
  // what makes you a participant is speaking, which is how conversation works.
  const joining = (typeof flags.join === 'string' && flags.join)
    || (typeof args[0] === 'string' && !flags.title ? args[0] : null);
  if (flags.join === true) die(EXIT.REFUSED, '--join needs a thread id: agora open --join <thread>');
  if (joining) return cmds.read({ ...flags }, [joining]);

  if (!flags.title) {
    die(EXIT.REFUSED,
      'usage: agora open --as A --title "..." [--paths a,b] [--work-item W] [-m "opening message"]');
  }
  const intent = {
    title: String(flags.title),
    paths: csv(flags.paths),
    tags: csv(flags.tags),
    work_item: flags['work-item'] || null,
    thread: deriveThreadId(flags.title, flags['work-item']),
  };
  for (const p of intent.paths) if (shaOf(p) === null) die(EXIT.REFUSED, `--paths names a missing file: ${p}`);

  // The derived id may already belong to a settled thread — the matcher will
  // not surface it (it only ranks open threads), and without this check the
  // descriptor gets rewritten to "open" for a conversation nothing can post
  // to. Refuse before writing anything, and say what to do instead.
  const prior = threadState(intent.thread);
  if (prior.terminal) {
    die(EXIT.REFUSED,
      `${intent.thread} is already settled (${prior.terminal.type} at ${prior.terminal.ts}). `
      + `Read it first: agora read ${intent.thread} — then, if this is genuinely a new `
      + 'question, open it under a different --title'
      + (intent.work_item ? ' (the work item keeps pointing at the settled thread)' : '') + '.');
  }

  const cands = rankCandidates(intent);
  const declined = [].concat(flags.decline || []).filter((x) => typeof x === 'string');

  // Declining the thread your own intent derives is not divergence, it is a
  // no-op that reads like one: the "new" thread would be the same id, so the
  // decline would be recorded and then immediately contradicted by writing a
  // second opener into the thread you just declined.
  if (declined.includes(intent.thread)) {
    die(EXIT.REFUSED,
      `${intent.thread} is the id this intent derives — declining it would reopen the same `
      + 'thread. Change --title, or give it a distinct --work-item.');
  }

  const blocking = cands.filter((c) => BLOCKS.includes(c.tier) && !declined.includes(c.d.thread));

  if (blocking.length && !declined.length) {
    printCandidates(cands);
    console.log('');
    console.log('Nothing was created. Join one:');
    console.log(`  agora open --as ${agent} --join ${blocking[0].d.thread}`);
    console.log('…or decline it, on the record:');
    console.log(`  agora open --as ${agent} --title "${intent.title}" `
      + `--decline ${blocking[0].d.thread} --reason "why this is a different question"`);
    return;
  }
  if (blocking.length) {
    die(EXIT.REFUSED,
      `still matched by ${blocking.map((c) => c.d.thread).join(', ')} — decline each one or join it`);
  }
  if (declined.length && !flags.reason) {
    die(EXIT.REFUSED, '--decline needs --reason "..." — a silent duplicate is the failure this prevents');
  }

  // A declined suggestion is published, not discarded. It stops duplicate
  // threads being silent, and it is the only real signal for whether matching
  // is tuned right — repeated declines against one candidate mean the matcher
  // is wrong, not the agents.
  for (const cand of declined) {
    produce(T.index, `diverge/${intent.thread}/${cand}`, {
      id: mkid(), ts: now(), type: 'DIVERGE', from: { agent },
      thread: intent.thread, declined: cand, reason: String(flags.reason),
    });
  }

  refreshDescriptor(intent.thread, {
    title: intent.title, work_item: intent.work_item, tags: intent.tags,
    paths: intent.paths, status: 'open',
  });

  if (cands.length) {
    console.log(`(${cands.length} candidate${cands.length > 1 ? 's' : ''} considered, `
      + `${declined.length} declined on the record)`);
  }
  console.log(`OPENED  ${intent.thread}`);

  const body = flags.m || flags.message;
  if (body) return cmds.say({ ...flags, thread: intent.thread }, ['REQUEST_REVIEW']);
  console.log(`  next: agora say REQUEST_REVIEW --as ${agent} --thread ${intent.thread} -m "..."`);
};

/** Observer read. Follows supersede pointers so a merged argument keeps its
 *  evidence — the messages stay where they were published and nothing is
 *  copied or reordered. */
cmds.read = (flags, args) => {
  const id = args[0] || flags.thread;
  if (!id) die(EXIT.REFUSED, 'usage: agora read <thread>');
  const { desc } = indexRead();
  const d = desc.get(id);
  const sources = [id, ...((d && d.absorbed) || [])];
  const msgs = readAll(T.threads)
    .filter((e) => sources.includes(e.thread))
    .sort((a, b) => (a.ts < b.ts ? -1 : 1))
    .map(markStale)
    .map(markVerified);
  if (!msgs.length && !d) die(EXIT.REFUSED, `no such thread: ${id}`);

  if (flags.json) return console.log(JSON.stringify({ descriptor: d || null, messages: msgs }));
  if (d) {
    console.log(`${id}  ${d.status}  hop ${d.hop}/${HOP_CAP}  [${(d.participants || []).join(', ')}]`);
    if (d.title) console.log(`  title: ${d.title}`);
    if (d.work_item) console.log(`  work-item: ${d.work_item}`);
    if ((d.paths || []).length) console.log(`  paths: ${d.paths.join(', ')}`);
    if (d.superseded_by) console.log(`  superseded by ${d.superseded_by}`);
    if ((d.absorbed || []).length) console.log(`  absorbed: ${d.absorbed.join(', ')}`);
    console.log('');
  }
  const me = flags.as || process.env.AGORA_AGENT;
  console.log(msgs.map((e) => render(e, me)).join('\n\n'));
  console.log(`\n(observing — you are not a participant until you post to ${id})`);
};

/**
 * Convergence after the fact.
 *
 * Matching will miss: two agents can start minutes apart on work that only
 * turns out to be one subject at hop 3. This is the recovery both of the
 * sessions on this bus improvised by hand, promoted to a message type. It
 * links rather than copies — the messages stay where they were published and
 * `read` on the target follows the pointer — and hop budgets do not sum,
 * because merging two half-spent arguments into one exhausted thread would
 * escalate a conversation that had barely started.
 */
cmds.supersede = (flags) => {
  const agent = agentName(flags);
  const src = flags.thread;
  const dst = flags.into;
  if (!src || !dst) {
    die(EXIT.REFUSED, 'usage: agora supersede --as A --thread <source> --into <target> [-m "why"]');
  }
  if (src === dst) die(EXIT.REFUSED, 'a thread cannot supersede itself');

  const from = threadState(src);
  if (!from.exists) die(EXIT.REFUSED, `no such thread: ${src}`);
  if (from.terminal) {
    die(EXIT.REFUSED, `${src} is already closed (${from.terminal.type} at ${from.terminal.ts})`);
  }
  const into = threadState(dst);
  if (!into.exists) die(EXIT.REFUSED, `no such thread: ${dst}`);
  if (into.terminal) {
    die(EXIT.REFUSED,
      `${dst} is closed (${into.terminal.type}) — you cannot merge into a settled thread`);
  }

  const body = flags.m || flags.message
    || `Superseded by ${dst}, where this subject is being settled.`;
  produce(T.threads, src, {
    id: mkid(), ts: now(), type: 'SUPERSEDE', from: { agent },
    thread: src, into: dst, hop: from.hop, body, refs: [],
  });

  const { desc } = indexRead();
  const target = desc.get(dst) || {};
  const srcDesc = desc.get(src) || {};
  refreshQuietly(src, { status: 'superseded', superseded_by: dst });
  refreshQuietly(dst, {
    absorbed: [...new Set([...(target.absorbed || []), src])],
    paths: srcDesc.paths || [],
  });
  console.log(`SUPERSEDE  ${src} → ${dst}`);
  console.log(`  ${src} is closed; its messages stay where they are and `
    + `agora read ${dst} now follows the pointer.`);
  console.log(`  ${dst} keeps its own hop budget (${into.hop}/${HOP_CAP}) — budgets do not sum.`);
};

cmds.list = (flags) => {
  const { desc, diverges } = indexRead();
  let rows = [...desc.values()];
  if (!flags.all) rows = rows.filter((d) => d.status === 'open');
  if (typeof flags.path === 'string') rows = rows.filter((d) => (d.paths || []).includes(flags.path));
  if (typeof flags['work-item'] === 'string') rows = rows.filter((d) => d.work_item === flags['work-item']);
  if (typeof flags.agent === 'string') rows = rows.filter((d) => (d.participants || []).includes(flags.agent));
  if (typeof flags.match === 'string') {
    const q = flags.match.toLowerCase();
    rows = rows.filter((d) => `${d.title || ''} ${(d.tags || []).join(' ')}`.toLowerCase().includes(q));
  }
  rows.sort((a, b) => String(b.last_at || '').localeCompare(String(a.last_at || '')));

  if (flags.json) return console.log(JSON.stringify(rows));
  if (!rows.length) {
    return console.log(desc.size
      ? '(no threads match — try --all, or agora reindex if the index looks empty)'
      : '(index is empty — run: agora reindex)');
  }
  for (const d of rows) {
    console.log(`${String(d.status).toUpperCase().padEnd(11)}${d.thread.padEnd(34)}`
      + `hop ${d.hop}/${HOP_CAP}  [${(d.participants || []).join(', ') || '—'}]`
      + `${d.work_item ? `  ${d.work_item}` : ''}`);
    if (d.title) console.log(`           ${d.title.slice(0, 100)}`);
    if ((d.paths || []).length) console.log(`           paths: ${d.paths.slice(0, 6).join(', ')}`);
    if (d.superseded_by) console.log(`           → superseded by ${d.superseded_by}`);
  }
  if (flags.diverges) {
    console.log('');
    for (const v of diverges) {
      console.log(`DIVERGE  ${v.thread} declined ${v.declined}  (${v.from.agent})`);
      console.log(`         ${v.reason}`);
    }
  }
};

/**
 * Operator repair, available as a command until there is an operator.
 *
 * Client-writes keep discovery working with no operator running; this is the
 * other half — it stops drift accumulating, and it is how threads that predate
 * the index get descriptors at all.
 */
cmds.reindex = () => {
  const ids = [...new Set(readAll(T.threads).map((e) => e.thread).filter(Boolean))];
  if (!ids.length) return console.log('(no threads to index)');
  for (const id of ids) {
    const d = refreshDescriptor(id);
    console.log(`indexed ${id.padEnd(30)} ${d.status.padEnd(11)} ${(d.paths || []).length} paths`);
  }
  console.log(`\n${ids.length} descriptor${ids.length > 1 ? 's' : ''} written to ${T.index}`);
};

cmds.help = () => {
  console.log(`agora — a chat room for agents sharing this workspace

  doctor                              broker health, topics, live leases
  topics          [--ensure]          show or create the topics the protocol needs
  enroll          --name <base> [--runtime R] [--json]
                  one call to be oriented: assigned handle, signing key,
                  doorbell to live end, and a map of what is in flight
  whoami          --as A              your identity and whether its key is published
  join            --as A              seek to live end only (enroll does this and more)
  presence                            who is listening
  leases                              who holds what

  claim <path>    --as A [--ttl 30m] [--thread T]   take the lease (exit 75 if denied)
  release <path>  --as A              give it back
  edit <path>     --as A [--thread T] [-m "..."]   log a change with its sha

  say <TYPE>      --as A --thread T -m "..." [--reply-to ID] [--ref p#L1-9]
                  REQUEST_REVIEW COMMENT EVIDENCE DISPUTE APPROVE
                  CONCEDE INTERRUPT RESOLVE ESCALATE
  decide          --thread T [--via A] -m "..."   human lane only; closes it
                  --via names the agent that relayed the human's answer
  escalations     [--as A]            open escalations and who owes the ask

  web             start|stop|restart|status         dashboard on :7788
  operator        start|stop|restart|status         the reconcile loop
                  sweep [--dry-run] [--json]        one pass, by hand

  wait            --as A [--timeout 900] [--json]   the doorbell
  catchup         [--thread T] [--json]             ordered replay
  threads                             open threads, hop counts, last line

finding the right conversation, instead of starting a second one:

  open            --as A --title "..." [--paths a,b] [--work-item W] [--tags x,y]
                  [-m "opening message"]            propose an intent; get candidates
                  --join T                          read one instead of opening
                  --decline T --reason "..."        decline it, on the record, then open
  read <thread>   [--json]            full history, observer only — no participation
  list            [--path P] [--work-item W] [--agent A] [--match S]
                  [--all] [--diverges] [--json]     what is already in flight
  supersede       --as A --thread <source> --into <target> [-m "why"]
                  merge after the fact; links, never copies; budgets do not sum
  reindex                             rebuild every descriptor from the log

exit codes: 0 ok · 64 doorbell timeout · 65 refused · 69 no broker · 75 denied`);
};

/* ── arg parsing ───────────────────────────────────────────────────── */

function parseArgs(argv) {
  const flags = {}; const args = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const k = a.slice(2);
      const next = argv[i + 1];
      if (next === undefined || next.startsWith('--')) { flags[k] = true; }
      else if (k === 'ref' || k === 'decline') { flags[k] = [].concat(flags[k] || [], next); i++; }
      else { flags[k] = next; i++; }
    } else if (a === '-m') { flags.m = argv[++i]; }
    else { args.push(a); }
  }
  return { flags, args };
}

const [, , cmd, ...rest] = process.argv;
if (!cmd || cmd === '--help' || cmd === '-h') { cmds.help(); process.exit(0); }
if (!cmds[cmd]) { process.stderr.write(`agora: unknown command "${cmd}"\n\n`); cmds.help(); process.exit(EXIT.REFUSED); }
const { flags, args } = parseArgs(rest);
cmds[cmd](flags, args);
