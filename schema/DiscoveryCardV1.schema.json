{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agora:discovery:v1:DiscoveryCardV1",
  "title": "DiscoveryCardV1",
  "description": "One bounded discovery suggestion source. A card is not authorization or proof of agent participation.",
  "oneOf": [
    { "$ref": "#/$defs/controllerRoute" },
    { "$ref": "#/$defs/agent" },
    { "$ref": "#/$defs/thread" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["v", "kind", "topicFacets", "stableRefs", "capabilityFacets", "keywords", "contactModes", "issuedAt", "expiresAt", "sourceVersion"],
      "properties": {
        "v": { "const": 1 },
        "kind": { "enum": ["controller_route", "agent", "thread"] },
        "topicFacets": { "$ref": "#/$defs/facets" },
        "stableRefs": { "$ref": "#/$defs/uris" },
        "capabilityFacets": { "$ref": "#/$defs/facets" },
        "keywords": { "$ref": "#/$defs/tokens" },
        "contactModes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["ask", "direct_message", "observe", "request_join"] }
        },
        "issuedAt": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
        "expiresAt": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
        "sourceVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64 }
      }
    },
    "controllerRoute": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "kind", "topicFacets", "stableRefs", "capabilityFacets", "keywords", "contactModes", "issuedAt", "expiresAt", "sourceVersion", "routeId", "handle", "authorityId"],
          "properties": {
            "v": { "const": 1 }, "kind": { "const": "controller_route" },
            "topicFacets": { "$ref": "#/$defs/facets" }, "stableRefs": { "$ref": "#/$defs/uris" },
            "capabilityFacets": { "$ref": "#/$defs/facets" }, "keywords": { "$ref": "#/$defs/tokens" },
            "contactModes": { "const": ["ask"] },
            "issuedAt": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
            "expiresAt": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
            "sourceVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
            "routeId": { "type": "string", "pattern": "^route://[^\\s]{1,240}$", "maxLength": 256 },
            "handle": { "$ref": "#/$defs/handle" }, "authorityId": { "$ref": "#/$defs/uri" }
          }
        }
      ]
    },
    "agent": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "kind", "topicFacets", "stableRefs", "capabilityFacets", "keywords", "contactModes", "issuedAt", "expiresAt", "sourceVersion", "principalId", "handle", "authorityId"],
          "properties": {
            "v": { "const": 1 }, "kind": { "const": "agent" },
            "topicFacets": { "$ref": "#/$defs/facets" }, "stableRefs": { "$ref": "#/$defs/uris" },
            "capabilityFacets": { "$ref": "#/$defs/facets" }, "keywords": { "$ref": "#/$defs/tokens" },
            "contactModes": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "contains": { "const": "direct_message" }, "items": { "enum": ["direct_message"] } },
            "issuedAt": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
            "expiresAt": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
            "sourceVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
            "principalId": { "type": "string", "pattern": "^agent://[^\\s]{1,240}$", "maxLength": 256 },
            "handle": { "$ref": "#/$defs/handle" }, "authorityId": { "$ref": "#/$defs/uri" }
          }
        }
      ]
    },
    "thread": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "kind", "topicFacets", "stableRefs", "capabilityFacets", "keywords", "contactModes", "issuedAt", "expiresAt", "sourceVersion", "threadId", "title", "authorityId", "status", "joinMode", "memberCount", "descriptorVersion"],
          "properties": {
            "v": { "const": 1 }, "kind": { "const": "thread" },
            "topicFacets": { "$ref": "#/$defs/facets" }, "stableRefs": { "$ref": "#/$defs/uris" },
            "capabilityFacets": { "$ref": "#/$defs/facets" }, "keywords": { "$ref": "#/$defs/tokens" },
            "contactModes": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["observe", "request_join"] } },
            "issuedAt": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
            "expiresAt": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
            "sourceVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
            "threadId": { "type": "string", "pattern": "^thread://[^\\s]{1,239}$", "maxLength": 256 },
            "title": { "type": "string", "minLength": 1, "maxLength": 256 },
            "authorityId": { "$ref": "#/$defs/uri" },
            "status": { "enum": ["open", "resolved", "escalated", "decided", "superseded"] },
            "joinMode": { "enum": ["invite_only", "request", "closed"] },
            "memberCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "descriptorVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      ]
    },
    "facets": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$", "maxLength": 128 } },
    "tokens": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64 } },
    "uris": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/uri" } },
    "uri": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]{1,240}$", "maxLength": 256 },
    "handle": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$", "maxLength": 64 }
  },
  "x-agora-semantic-constraints": ["expiresAt-after-issuedAt", "agent-contactModes-contains-direct_message"]
}
