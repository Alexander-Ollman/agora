{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agora:discovery:v1:DiscoveryQueryV1",
  "title": "DiscoveryQueryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "kinds", "topicFacets", "stableRefs", "capabilityFacets", "textTokens", "limit"],
  "properties": {
    "v": { "const": 1 },
    "kinds": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["controller_route", "agent", "thread"] } },
    "topicFacets": { "$ref": "#/$defs/facets" },
    "stableRefs": { "$ref": "#/$defs/uris" },
    "capabilityFacets": { "$ref": "#/$defs/facets" },
    "textTokens": { "$ref": "#/$defs/tokens" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cursor": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 512 }
  },
  "$defs": {
    "facets": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$", "maxLength": 128 } },
    "tokens": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64 } },
    "uris": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]{1,240}$", "maxLength": 256 } }
  },
  "x-agora-semantic-constraints": ["at-least-one-discovery-signal"]
}
